""")

code("""# Final inference on unlabeled Validation/ -> CSV
def gather_images(root: Path):
    # all files recursively under Validation/
    exts={'.jpg','.jpeg','.png','.bmp','.webp','.tif','.tiff'}
    return [p for p in root.rglob('*') if p.suffix.lower() in exts]

from torchvision.transforms.functional import to_tensor, normalize, resize, center_crop
def preprocess_pil(img):
    # mirror eval_tfms
    img = img.convert('RGB')
    img = img.resize((256,256))
    img = center_crop(to_tensor(img), [IMG_SIZE, IMG_SIZE])  # center crop after resize
    # Need Normalize on CHW tensor
    mean=torch.tensor([0.485,0.456,0.406])[:,None,None]
    std =torch.tensor([0.229,0.224,0.225])[:,None,None]
    return normalize(img, mean, std)

img_paths = gather_images(VALI_DIR)
print('Validation images (unlabeled):', len(img_paths))

def predict_image(path: Path):
    from PIL import Image as PILImage
    model.eval()
    with torch.no_grad():
        img = PILImage.open(path).convert('RGB')
        x = transforms.Compose([
            transforms.Resize((256,256)),
            transforms.CenterCrop(IMG_SIZE),
            transforms.ToTensor(),
            transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),
        ])(img).unsqueeze(0).to(device)
        probs = torch.softmax(model(x), dim=1).cpu().numpy()[0]
    pred_idx=int(np.argmax(probs))
    return class_names[pred_idx], probs

rows=[]
for p in img_paths:
    label, probs = predict_image(p)
    row = {'filepath': str(p)}
    row['pred_class']=label
    for i,cn in enumerate(class_names):
        row[f'prob_{cn}']=float(probs[i])
    rows.append(row)

df=pd.DataFrame(rows).sort_values('filepath')
csv_path=OUT_DIR/'validation_predictions.csv'
df.to_csv(csv_path, index=False)
print('Wrote', csv_path.resolve())
df.head()
""")

